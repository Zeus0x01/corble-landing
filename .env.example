# PostgreSQL — local Docker in development, Supabase in production (Vercel).
DATABASE_URL="postgresql://corble:corble@localhost:5432/corble"
# Supabase (Vercel) — use the POOLED connection string (port 6543) with pgbouncer params
# for serverless, and the DIRECT connection string (port 5432) only for `prisma migrate`:
#   pooled:    postgresql://postgres.PROJECT:password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#   direct:    postgresql://postgres.PROJECT:password@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_DIRECT_URL="postgresql://postgres:password@db.PROJECT.supabase.co:5432/postgres"

# Auth.js — generate a long random string, e.g. `openssl rand -base64 32`
AUTH_SECRET="change-me"

# Public URL of the app (used by Auth.js / redirects)
AUTH_URL="http://localhost:3000"

# Admin bootstrap (used by prisma/seed.ts) — NEVER use the known default in production.
# Seeding is refused in production entirely (override with ALLOW_SEED=true at your own risk).
SEED_ADMIN_EMAIL="admin@corble.net"
SEED_ADMIN_PASSWORD="change-me-dev-only"

# Email — transactional mail via Resend. Without RESEND_API_KEY emails are NOT
# sent (the app logs and skips instead). EMAIL_FROM must be a verified domain
# in Resend (onboarding@resend.dev only works for your own Resend account email).
RESEND_API_KEY=""
EMAIL_FROM="Corble <tasks@yourdomain.com>"

# Optional: S3-compatible file storage (Cloudflare R2 / MinIO).
# If these are missing in development, uploads fall back to local ./uploads.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Incoming leads webhook — n8n must send it in the `x-ingest-secret` header.
# Generate with: openssl rand -hex 32
INGEST_WEBHOOK_SECRET=""

# GitHub integration — PAT with contents:read + contents:write for repo browsing,
# file commits (never to main/master/production) and template imports.
# Fine-grained or classic token: https://github.com/settings/tokens
GITHUB_TOKEN=""

# Vercel integration — token with Deployment create+read for preview/production
# deploys fired from the workspace: https://vercel.com/account/tokens
VERCEL_TOKEN=""
